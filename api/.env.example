# Sahotsava Backend - Environment Variables
# Copy this file to .env and fill in your actual values
# ALL fields marked as REQUIRED must be filled for the server to start

# ==============================================
# DATABASE CONFIGURATION (REQUIRED)
# ==============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/sahotsava

# ==============================================
# SECURITY CONFIGURATION (REQUIRED)
# ==============================================
# Secret key for JWT token signing
# Generate a strong random string for production: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Refresh token secret (optional, but recommended for production)
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production

# ==============================================
# REDIS CONFIGURATION (REQUIRED)
# ==============================================
# Redis connection URL
# Format: redis://[username:password@]host:port[/database]
REDIS_URL=redis://localhost:6379

# Queue provider to use: bullmq | rabbitmq
QUEUE_PROVIDER=bullmq

# RabbitMQ URL (used when QUEUE_PROVIDER=rabbitmq)
RABBITMQ_URL=amqp://localhost:5672

# ==============================================
# SERVER CONFIGURATION (REQUIRED)
# ==============================================
# Server port number
PORT=8989

# Server host address
# Use 0.0.0.0 to listen on all network interfaces
# Use localhost for local-only access
HOST=0.0.0.0

# ==============================================
# CORS CONFIGURATION (REQUIRED)
# ==============================================
# Comma-separated list of allowed CORS origins
# Add your frontend URLs here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==============================================
# EMAIL CONFIGURATION (REQUIRED for email features)
# ==============================================
# Your email address (Gmail recommended)
EMAIL=your-email@gmail.com

# Gmail App Password (16-character password from Google Account)
# Generate at: https://myaccount.google.com/apppasswords
APP_PASSWORD=xxxx xxxx xxxx xxxx

# Application URL (used in email verification links)
# For development: http://localhost:8989
# For production: https://yourdomain.com
APP_URL=http://localhost:8989

# ==============================================
# ADMIN CONFIGURATION (OPTIONAL)
# ==============================================
# Super admin credentials for initial setup
SUPER_ADMIN_EMAIL=admin@speaktrace.com
SUPER_ADMIN_PASS=change-me-in-production

# ==============================================
# ENVIRONMENT (OPTIONAL)
# ==============================================
# Node environment: development, production, staging
# This overrides the value in config.yaml if set
NODE_ENV=development

# ==============================================
# NOTES
# ==============================================
# 1. Never commit .env file with actual credentials to version control
# 2. Keep .env in .gitignore
# 3. Each environment (dev, staging, prod) should have its own .env file
# 4. For production, use strong, randomly generated secrets
# 5. Rotate secrets regularly in production
# 6. The server will NOT start if required variables are missing
# 7. See config/README.md for detailed documentation
