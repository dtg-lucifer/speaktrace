# ─── Server ───────────────────────────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development          # development | production
LOG_LEVEL=debug              # debug | info | warning | error

# ─── LLM — Gemini (primary — all tasks use Gemini by default) ─────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model for chat agent, structured JSON, reasoning, and vision
GEMINI_MODEL=gemini-2.0-flash
GEMINI_CHAT_MODEL=gemini-2.0-flash

# ─── LLM — OpenRouter (optional fallback) ─────────────────────────────────────
# Only used if GEMINI_API_KEY is not set
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Reasoning model — chat agent, evaluation, vision, analysis
OPENROUTER_REASONING_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# General model — structured JSON output, plan generation (GPT-4o class)
OPENROUTER_GENERAL_MODEL=openai/gpt-4o-mini

# ─── LLM — OpenAI (optional fallback) ─────────────────────────────────────────
# Only used if GEMINI_API_KEY and OPENROUTER_API_KEY are not set
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o-mini

# ─── Backend API ──────────────────────────────────────────────────────────────
# URL of the backend service this agent calls as tools.
# The agent forwards the user's Bearer token to every call.
BACKEND_BASE_URL=http://localhost:3000

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
AI_CACHE_TTL=300             # seconds — TTL for cached AI responses

# ─── Agent ────────────────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=5       # max tool calls per agent run (prevents infinite loops)
CHAT_HISTORY_LIMIT=20        # rolling chat history window size
