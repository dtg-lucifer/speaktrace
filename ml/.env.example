# SpeakTrace ML & RAG Worker Environment Variables

APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0

# Redis connection (for BullMQ queues)
REDIS_URL=redis://localhost:6379

# RabbitMQ connection (used if QUEUE_PROVIDER=rabbitmq)
RABBITMQ_URL=amqp://speaktrace:speaktrace_pass@localhost:5672/speaktrace
QUEUE_PROVIDER=bullmq

# Cloudinary (same as API backend)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Ollama LLM integration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./chroma_db

# Hugging Face token for official Pyannote model weights (optional)
HF_TOKEN=
